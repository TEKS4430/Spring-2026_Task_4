# ============================================================
# Environment configuration
#   1. Copy this file:   cp env.example .env
#   2. Uncomment the TWO lines for YOUR operating system.
# .env is gitignored so each student sets it locally.
# Everything else (robot name, USER, WEBOTS_HOME) is already set
# in docker-compose.yml — do not add it here.
# ============================================================

# ── Linux ────────────────────────────────────────────────────
# NETWORK_MODE=host
# WEBOTS_HOST=localhost

# ── Mac & Windows ────────────────────────────────────────────
# NETWORK_MODE=bridge
# WEBOTS_HOST=host.docker.internal
